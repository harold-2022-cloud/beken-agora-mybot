 		return -1;
 	}
 
+#if CONFIG_BK_DHCPD_CAPTIVE_DNS
+	qend = dns_skip_qname(msg + sizeof(struct dns_header), endp);
+	if (!qend || qend + sizeof(struct dns_question) > endp) {
+		dhcp_e("ignoring malformed dns question\r\n");
+		return -1;
+	}
+
+	question = (struct dns_question *)qend;
+	qtype = ntohs(question->type);
+	qclass = ntohs(question->class);
+	send_len = qend + sizeof(struct dns_question) - msg;
+
+	hdr->flags.fields.qr = 1;
+	hdr->flags.fields.opcode = 0;
+	hdr->flags.fields.aa = 1;
+	hdr->flags.fields.tc = 0;
+	hdr->flags.fields.rd = 1;
+	hdr->flags.fields.ra = 0;
+	hdr->flags.fields.rcode = 0;
+	flags = hdr->flags.num;
+	hdr->flags.num = htons(hdr->flags.num);
+	hdr->num_questions  = htons(0x01);
+
+	if (qtype == 1 && qclass == 1 && send_len + sizeof(struct dns_rr) <= SERVER_BUFFER_SIZE) {
+		answer = (struct dns_rr *)(msg + send_len);
+		answer->name_ptr = htons(0xC00C);
+		answer->type = htons(0x01);
+		answer->class = htons(0x01);
+		answer->ttl = htonl(30);
+		answer->rdlength = htons(0x04);
+		answer->rd = dhcps.router_ip;
+		hdr->answer_rrs = htons(0x01);
+		send_len += sizeof(struct dns_rr);
+	} else {
+		hdr->answer_rrs = 0;
+	}
+
+	hdr->authority_rrs = 0;
+	hdr->additional_rrs = 0;
+	SEND_RESPONSE(dhcps.dnssock, (struct sockaddr *)fromaddr,
+		      msg, send_len);
+
+	query_count++;
+	if (query_count <= 8 || (query_count % 32) == 0) {
+		LWIP_LOGI("[CAPTIVE_DNS_BUILTIN] query=%u qtype=%u qclass=%u answer_rrs=%u answer=0x%08x flags=0x%04x\r\n",
+			  (unsigned)query_count,
+			  (unsigned)qtype,
+			  (unsigned)qclass,
+			  (unsigned)ntohs(hdr->answer_rrs),
+			  (unsigned)dhcps.router_ip,
+			  (unsigned)flags);
+	}
+
+	return 0;
+#else
 	/* make the header represent a response */
 	hdr->flags.fields.qr = 1;
 	hdr->flags.fields.opcode = 0;
@@ -343,6 +435,7 @@ static int process_dns_message(char *msg, int len, struct sockaddr_in *fromaddr)
 		      msg, endp - msg);
 
 	return -1;
+#endif
 }
 
 static int process_dhcp_message(char *msg, int len)
